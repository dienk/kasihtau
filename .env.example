# ─── Required: Supabase Configuration ───────────────────────────────────────
# Get these from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Build Only: Prisma Schema Compatibility ────────────────────────────────
# The app uses Supabase client SDK directly, not Prisma queries.
# This URL is only needed for `prisma generate` during build.
# It can be any valid PostgreSQL URL format.
DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder

# ─── Optional: WebSocket Service ────────────────────────────────────────────
# Only used for local development with the mini-services WebSocket server.
# Not needed for Vercel/serverless deployments.
# WS_PORT=3003
