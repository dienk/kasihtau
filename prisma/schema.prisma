// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// To switch to Supabase PostgreSQL:
// 1. Change provider from "sqlite" to "postgresql"
// 2. Set DATABASE_URL in .env to your Supabase connection string
//    (find it at: https://supabase.com/dashboard → Project → Settings → Database)
// 3. Run: bun run db:push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Notification {
  id         String   @id @default(cuid())
  appName    String   @default("Unknown")
  title      String
  message    String
  prefix     String?
  isRead     Boolean  @default(false)
  isFiltered Boolean  @default(false)
  isPushed   Boolean  @default(false)
  pushStatus String   @default("pending") // pending, success, failed
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  pushLogs   PushLog[]
}

model FilterRule {
  id        String   @id @default(cuid())
  prefix    String   @unique
  matchMode String   @default("contains") // "startsWith" or "contains"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushConfig {
  id        String   @id @default(cuid())
  url       String
  method    String   @default("POST")
  headers   String   @default("{}") // JSON string for custom headers
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pushLogs  PushLog[]
}

model PushLog {
  id             String   @id @default(cuid())
  notificationId String
  pushConfigId   String?
  status         String   @default("pending") // pending, success, failed
  requestBody    String   @default("{}") // JSON of what was sent
  responseStatus Int?
  responseBody   String?
  errorMessage   String?
  pushedAt       DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  pushConfig   PushConfig?  @relation(fields: [pushConfigId], references: [id], onDelete: SetNull)
}

model AirtableConfig {
  id        String   @id @default(cuid())
  baseUrl   String   // e.g. https://airtable.com/appS02vV9NX6QERC7
  baseId    String   // e.g. appS02vV9NX6QERC7
  token     String   // Personal Access Token
  tableName String   @default("Notifications") // Table name in Airtable
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupabaseConfig {
  id        String   @id @default(cuid())
  url       String   // e.g. https://xyzproject.supabase.co
  anonKey   String   // The publishable/anon key (sb_publishable_...)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
