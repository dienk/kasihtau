// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Note: The app uses Supabase PostgreSQL via the client SDK (@supabase/supabase-js)
// directly (see src/lib/supabase-db.ts). This Prisma schema is kept for reference
// and is not actively used for database operations.
//
// The DATABASE_URL env var is needed for `prisma generate` but doesn't need
// to point to a real database - only the Supabase URL/key are used at runtime.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model Notification {
  id         String   @id @default(cuid())
  appName    String   @default("Unknown")  @map("app_name")
  title      String
  message    String
  prefix     String?
  isRead     Boolean  @default(false) @map("is_read")
  isFiltered Boolean  @default(false) @map("is_filtered")
  isPushed   Boolean  @default(false) @map("is_pushed")
  pushStatus String   @default("pending") @map("push_status")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  pushLogs   PushLog[]

  @@map("notifications")
}

model FilterRule {
  id        String   @id @default(cuid())
  prefix    String   @unique
  matchMode String   @default("contains") @map("match_mode")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("filter_rules")
}

model PushConfig {
  id        String   @id @default(cuid())
  url       String
  method    String   @default("POST")
  headers   String   @default("{}")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  pushLogs  PushLog[]

  @@map("push_configs")
}

model PushLog {
  id             String   @id @default(cuid())
  notificationId String   @map("notification_id")
  pushConfigId   String?  @map("push_config_id")
  status         String   @default("pending")
  requestBody    String   @default("{}") @map("request_body")
  responseStatus Int?     @map("response_status")
  responseBody   String?  @map("response_body")
  errorMessage   String?  @map("error_message")
  pushedAt       DateTime @default(now()) @map("pushed_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  pushConfig   PushConfig?  @relation(fields: [pushConfigId], references: [id], onDelete: SetNull)

  @@map("push_logs")
}
